{
	"name": "mit-pset-templates",
	"version": "1.1.1",
	"description": "Create MIT problem-set notes for college classes from a sidebar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"mit",
		"pset",
		"problem-set",
		"college",
		"university",
		"academia",
		"coursework",
		"templates"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.20.1",
		"esbuild": "0.25.5",
		"obsidian": "1.13.1",
		"obsidian-typings": "6.34.0",
		"typescript": "5.9.3",
		"vitest": "3.2.7"
	}
}
